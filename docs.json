{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Maljan",
  "description": "Multi-agent malware analysis in which every claim in the report resolves back to the tool call it came from.",
  "colors": {
    "primary": "#1d4ed8",
    "light": "#38bdf8",
    "dark": "#1d4ed8"
  },
